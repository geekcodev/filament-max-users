# Права доступа (строки проверяются через $user->can(...) — совместимо со spatie/laravel-permission и Gate).
# users.view — доступ к разделу «Max пользователи»;
# users.manage — действие «Обновить из MAX»;
# chats.view — доступ к разделу «Max чаты»;
# chats.delete — удаление записи чата из локального реестра.
FILAMENT_MAX_USERS_PERMISSION_USERS_VIEW=
FILAMENT_MAX_USERS_PERMISSION_USERS_MANAGE=
FILAMENT_MAX_USERS_PERMISSION_CHATS_VIEW=
FILAMENT_MAX_USERS_PERMISSION_CHATS_DELETE=
